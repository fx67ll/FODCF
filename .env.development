# 页面标题
VUE_APP_TITLE = fx67ll‘s 管理系统

# 开发环境配置
ENV = 'development'

# fx67ll‘s 管理系统/开发环境
# VUE_APP_BASE_API = '/dev-api'
VUE_APP_BASE_API = ''

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 验证码自动刷新间隔（毫秒）；后端有效期为 120 秒，提前 10 秒刷新
VUE_APP_CAPTCHA_REFRESH_INTERVAL = 110000

# fx67ll‘s logo
VUE_APP_LOGO_URL = 'https://test.fx67ll.com/fx67ll-img-collection/fx67ll.jpg'
